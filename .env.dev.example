# Development-only infrastructure created by docker-compose.dev-infra.yml
SIMAK_DATABASE_URL=mysql://simak:simak-dev-password@simak-dev-mariadb:3306/simak
DATABASE_URL=mysql://simak:simak-dev-password@127.0.0.1:3319/simak
SIMAK_DEV_DB_PASSWORD=simak-dev-password
SIMAK_DEV_DB_ROOT_PASSWORD=simak-dev-root-password

# RUAS authentication
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=https://ruas.smkpasirian-lmj.sch.id/api/auth

# SIMAK session and browser origin
SESSION_SECRET=change-this-local-session-secret
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Local RustFS
SIMAK_RUSTFS_ENDPOINT=http://simak-dev-rustfs:9000
RUSTFS_ENDPOINT=http://localhost:9019
RUSTFS_BUCKET=simak
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# API and local proxy
API_PORT=3001
SITE_DOMAIN=simak.localhost
SIMAK_HTTP_PORT=8080
SIMAK_HTTPS_PORT=8443
