# SIMAK database
# The API container resolves `mariadb` through the existing ferileenet network.
# Create this database and user in the existing MariaDB container first.
SIMAK_DATABASE_URL=mysql://simak:change-me-local@mariadb:3306/simak
# Used by local npm db commands only when MariaDB publishes a host port.
DATABASE_URL=mysql://simak:change-me-local@127.0.0.1:3309/simak

# RUAS authentication
# Current RUAS exposes POST /api/auth, so use the complete endpoint URL below.
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=http://localhost:3000/api/auth

# SIMAK session and browser origin
SESSION_SECRET=change-this-local-session-secret
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# RustFS
# The Docker API container resolves the existing RustFS container on ferileenet.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=simak
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# API
API_PORT=3001
