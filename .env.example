# SIMAK database
# The API container resolves `mariadb` through the existing ferileenet network.
# Create this database and user in the existing MariaDB container first.
SIMAK_DATABASE_URL=mysql://simak:change-me-local@mariadb:3306/simak
# Used by local npm db commands only when MariaDB publishes a host port.
DATABASE_URL=mysql://simak:change-me-local@127.0.0.1:3309/simak

# RUAS authentication
# The endpoint must be reachable from the API container; do not use localhost
# unless RUAS runs inside that same container.
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=https://ruas.smkpasirian-lmj.sch.id/api/auth
# Optional: internal RUAS endpoint that reports whether a student completed
# the RUAS quiz linked from an assignment. RUAS_INTERNAL_SECRET must match
# the SIMAK_INTERNAL_SECRET configured on the RUAS side. Leave both empty
# to disable the check (the quiz step then never shows as completed).
RUAS_STATUS_ENDPOINT=
RUAS_INTERNAL_SECRET=

# SIMAK session and browser origin
SESSION_SECRET=change-this-local-session-secret
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# RustFS
# Used by the Docker API container. Set a unique alias if ferileenet is shared.
SIMAK_RUSTFS_ENDPOINT=http://rustfs:9000
# Optional browser-reachable S3 endpoint used in presigned URLs.
RUSTFS_PUBLIC_ENDPOINT=
# Used only when running the API directly from the host.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=simak
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# API
API_PORT=3001
SIMAK_HTTP_PORT=8080
SIMAK_HTTPS_PORT=8443
