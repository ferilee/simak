# SIMAK database
MARIADB_DATABASE=simak
MARIADB_USER=simak
MARIADB_PASSWORD=change-me-local
MARIADB_ROOT_PASSWORD=change-root-local
DATABASE_URL=mysql://simak:change-me-local@127.0.0.1:3309/simak

# RUAS authentication
# Current RUAS exposes POST /api/auth, so use the complete endpoint URL below.
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=http://localhost:3000/api/auth

# SIMAK session and browser origin
SESSION_SECRET=change-this-local-session-secret
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# RustFS
RUSTFS_ENDPOINT=http://localhost:9013
RUSTFS_BUCKET=simak
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# API
API_PORT=3001
