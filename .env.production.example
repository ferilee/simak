# Salin ke environment secret Arcane; jangan commit file berisi nilai nyata.
SIMAK_IMAGE_TAG=GANTI_DENGAN_COMMIT_SHA
SIMAK_API_IMAGE=ghcr.io/ferilee/simak-api
SIMAK_WEB_IMAGE=ghcr.io/ferilee/simak-web

SIMAK_DATABASE_URL=mysql://simak:<password>@mariadb:3306/simak
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=https://ruas.smkpasirian-lmj.sch.id/api/auth
SESSION_SECRET=<random-minimal-32-characters>
CORS_ORIGIN=https://simak.smkpasirian-lmj.sch.id

SIMAK_RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=https://<domain-s3-rustfs>
RUSTFS_BUCKET=simak
RUSTFS_ACCESS_KEY=<rustfs-access-key>
RUSTFS_SECRET_KEY=<rustfs-secret-key>

# Port host yang menjadi upstream Nginx Proxy Manager.
SIMAK_HTTP_PORT=8080
