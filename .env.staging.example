# Jangan isi dengan kredensial production. Salin ke .env.staging untuk staging lokal.
SIMAK_STAGING_DB_PASSWORD=simak-staging-password
SIMAK_STAGING_DB_ROOT_PASSWORD=simak-staging-root-password
SIMAK_STAGING_DB_PORT=3339

# Login staging tetap diverifikasi oleh sumber akun RUAS.
RUAS_AUTH_MODE=internal-endpoint
RUAS_DATABASE_URL=
RUAS_AUTH_ENDPOINT=https://ruas.smkpasirian-lmj.sch.id/api/auth

SIMAK_STAGING_SESSION_SECRET=change-this-local-staging-secret-32chars
SIMAK_STAGING_CORS_ORIGIN=https://simak-staging.localhost:18443
SIMAK_STAGING_SITE_DOMAIN=simak-staging.localhost
NEXT_PUBLIC_SITE_URL=https://simak-staging.localhost:18443
SIMAK_STAGING_HTTP_PORT=18080
SIMAK_STAGING_HTTPS_PORT=18443
SIMAK_STAGING_LAN_HOST=192.168.1.50
SIMAK_STAGING_LAN_ORIGIN=http://192.168.1.50:18080

SIMAK_STAGING_RUSTFS_PORT=9119
SIMAK_STAGING_RUSTFS_CONSOLE_PORT=9120
SIMAK_STAGING_RUSTFS_PUBLIC_ENDPOINT=http://192.168.1.50:9119
SIMAK_STAGING_RUSTFS_BUCKET=simak-staging
SIMAK_STAGING_RUSTFS_ACCESS_KEY=simak-staging-access
SIMAK_STAGING_RUSTFS_SECRET_KEY=simak-staging-secret

# Dipakai hanya oleh perintah migrasi/seed dari host.
DATABASE_URL=mysql://simak:simak-staging-password@127.0.0.1:3339/simak
